    "test:visual:update": "node tests/ui/visual.mjs --update-baseline"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "fs-extra": "^11.2.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0"
  }
}